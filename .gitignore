# Logs del sistema y gestores de paquetes
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime & Process IDs
pids
*.pid
*.seed
*.pid.lock

# Directorios de dependencias
node_modules/
bower_components/

# Compilaciones y producción
dist/
dist-ssr/
*.local

# Archivos de entorno y credenciales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Bases de datos SQLite locales y diarios transaccionales (CRÍTICO)
*.db
*.db-journal
*.db-shm
*.db-wal
crm_local.db

# Carpetas de respaldos y snapshots locales
backups/
src_BACKUP_SNAPSHOT/

# Exportaciones de datos privados (evita fugar clientes o stock a GitHub)
*.csv
Backup_*.csv
Backup_*.json

# Archivos temporales de Editores e IDEs
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cobertura y testing
coverage/
*.lcov
.nyc_output/
.grunt/
lib-cov/